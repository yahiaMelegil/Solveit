{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared context, document and timeline shapes for Case v2",
  "$defs": {
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "expectedVersion"
      ]
    },
    "AttachContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "contextId": {
          "type": "integer",
          "minimum": 1
        },
        "contextVersion": {
          "type": "integer",
          "minimum": 1
        },
        "selectedFactKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "authorizeUse": {
          "const": true
        }
      },
      "required": [
        "expectedVersion",
        "contextId",
        "contextVersion",
        "selectedFactKeys",
        "authorizeUse"
      ]
    },
    "UploadDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "supporting/reference/work_sample, or requiredDocuments code from one of the selected catalog policies."
        },
        "file": {
          "type": "string",
          "format": "binary"
        }
      },
      "required": [
        "expectedVersion",
        "title",
        "category",
        "file"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": false
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "email_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "code",
        "message"
      ]
    },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentPage": {
          "type": "integer",
          "minimum": 1
        },
        "perPage": {
          "type": "integer",
          "minimum": 1
        },
        "lastPage": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "currentPage",
        "perPage",
        "lastPage",
        "total"
      ]
    },
    "ContextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "sourceContextVersionId": {
          "type": "integer",
          "minimum": 1
        },
        "selectedFactKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contextId": {
              "type": "integer",
              "minimum": 1
            },
            "contextVersion": {
              "type": "integer",
              "minimum": 1
            },
            "domain": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "effectiveDate": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "key",
                  "value",
                  "source",
                  "effectiveDate"
                ]
              }
            }
          },
          "required": [
            "contextId",
            "contextVersion",
            "domain",
            "country",
            "facts"
          ]
        },
        "policyVersionId": {
          "type": "integer",
          "minimum": 1
        },
        "authorizedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "detachedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sourceContextVersionId",
        "selectedFactKeys",
        "snapshot",
        "policyVersionId",
        "authorizedAt",
        "detachedAt"
      ]
    },
    "DocumentVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "category": {
          "enum": [
            "supporting",
            "reference",
            "work_sample"
          ]
        },
        "mimeType": {
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scanStatus": {
          "enum": [
            "pending",
            "clean",
            "rejected",
            "failed"
          ]
        },
        "scanReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "scannedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "category",
        "mimeType",
        "size",
        "checksum",
        "scanStatus",
        "scanReason",
        "scannedAt",
        "createdAt"
      ]
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "caseId": {
          "type": "integer",
          "minimum": 1
        },
        "caseVersion": {
          "type": "integer",
          "minimum": 1
        },
        "deletedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "currentVersion": {
          "$ref": "#/$defs/DocumentVersion"
        }
      },
      "required": [
        "id",
        "caseId",
        "deletedAt",
        "currentVersion"
      ]
    },
    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string"
        },
        "previousState": {
          "type": [
            "string",
            "null"
          ]
        },
        "newState": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "occurredAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "action",
        "previousState",
        "newState",
        "reasonCode",
        "occurredAt"
      ]
    },
    "DocumentResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "item": {
              "$ref": "#/$defs/Document"
            }
          },
          "required": [
            "item"
          ]
        }
      },
      "required": [
        "status",
        "message",
        "data"
      ]
    },
    "DocumentListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Document"
              }
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "items",
            "pagination"
          ]
        }
      },
      "required": [
        "status",
        "message",
        "data"
      ]
    },
    "DocumentVersionListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocumentVersion"
              }
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "items",
            "pagination"
          ]
        }
      },
      "required": [
        "status",
        "message",
        "data"
      ]
    },
    "TimelineEventListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TimelineEvent"
              }
            },
            "pagination": {
              "$ref": "#/$defs/Pagination"
            }
          },
          "required": [
            "items",
            "pagination"
          ]
        }
      },
      "required": [
        "status",
        "message",
        "data"
      ]
    }
  }
}
